# Copy this file to `.env` in the same folder and fill in real values.
# .env is already git-ignored — never commit real secrets.

PORT=5000
MONGO_URI=mongodb://localhost:27017/llm_security
ML_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-this-to-a-long-random-string

# --- LLM Provider ---
# "groq"   = (default) cloud API, needs a key from https://console.groq.com
# "ollama" = runs 100% locally, no API key needed
LLM_PROVIDER=groq

# --- Groq config (used when LLM_PROVIDER=groq, and by the LLM guard layers) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TLS_INSECURE=false
# gpt-oss reasoning depth: low | medium | high
LLM_REASONING_EFFORT=medium
LLM_MAX_COMPLETION_TOKENS=4096

# --- Ollama config (used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Guard layers (need GROQ_API_KEY; the ML ensemble always runs) ---
LLM_GUARDS_ENABLED=true
OUTPUT_GUARD_ENABLED=true
# closed = refuse requests if a guard layer is unreachable; open = skip that layer
GUARD_FAIL_MODE=closed
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PROMPT_GUARD_BLOCK_THRESHOLD=0.8
PROMPT_GUARD_WARN_THRESHOLD=0.5
SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b

# --- Rate limiting ---
RATE_LIMIT_MAX=10
